# Copia este archivo a .env.deploy y completa los valores con los datos
# del cluster MySQL-compatible (TiDB Cloud Starter o db4free.net).
# .env.deploy no se sube a Git.
NODE_ENV=production
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=tu-usuario.root
DB_PASSWORD=tu-password
DB_NAME=medicita
DB_CONNECTION_LIMIT=5
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT_MS=10000
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# Ruta local al ca.pem descargado desde TiDB Cloud.
DB_SSL_CA_PATH=C:\ruta\al\ca.pem
# Con db4free.net usa DB_SSL=false y DB_PORT=3306.

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=pega-aqui-un-secreto-de-48-bytes
JWT_EXPIRES_IN=8h

ADMIN_FIRST_NAMES=
ADMIN_LAST_NAMES=
ADMIN_EMAIL=
ADMIN_PASSWORD=
