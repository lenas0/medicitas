{
  "name": "medicitas-backend",
  "version": "1.0.0",
  "description": "REST API for the MediCita MySQL database",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js && node --check scripts/initDb.js",
    "db:init": "node scripts/initDb.js",
    "create-admin": "node scripts/createAdmin.js",
    "migrate-passwords": "node scripts/migratePasswords.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "swagger-ui-express": "^5.0.1"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
