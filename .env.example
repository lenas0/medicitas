PORT=5000
NODE_ENV=development
JSON_BODY_LIMIT=1mb
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=medicita
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT_MS=10000
JWT_SECRET=replace-this-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
ADMIN_FIRST_NAMES=
ADMIN_LAST_NAMES=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Managed MySQL (production) ---
# Set DB_SSL=true when the provider requires TLS (Aiven, PlanetScale-like, etc.).
# Provide the provider CA certificate either as base64 (recommended for Render)
# or as a file path on the server.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA_BASE64=
DB_SSL_CA_PATH=
